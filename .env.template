# chiron environment — copy to .env and fill in:  cp .env.template .env
#
# The Python CLI (uv run python -m tools.lingua ...) auto-loads this file
# from the repo root. Variables already set in your shell take precedence,
# and empty lines below are ignored.
#
# The web viewer is separate: Next.js only reads env files under web/, so
# put ANTHROPIC_API_KEY (and CHIRON_AGENT_MODEL) in web/.env.local too if
# you want the learning agent to use a key instead of your `claude` login.

# Required for the API-native authoring stage (tools.lingua author) — it
# calls the Claude API directly. Alternatively, `ant auth login` works
# without any key here.
ANTHROPIC_API_KEY=

# Authoring model + reasoning effort (defaults shown; leave empty to use
# them). Effort: low | medium | high | xhigh | max.
CHIRON_AUTHOR_MODEL=claude-sonnet-5
CHIRON_AUTHOR_EFFORT=medium

# Where the development environment lives. Default: devenv/ beside this file,
# with reference/ and workspace/ inside it. Absolute or repo-relative; leave
# empty to use chiron.yaml. `./ch devenv` prints what it resolved to.
CHIRON_DEVENV=

# Web viewer coach model override, and the reference room the viewer reads
# (both read from web/.env.local, not this file; listed here so one template
# documents every knob). CHIRON_REFERENCE_DIR is relative to web/ and only
# needed when CHIRON_DEVENV moved the root.
CHIRON_AGENT_MODEL=
CHIRON_REFERENCE_DIR=
