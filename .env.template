# chiron environment — copy to .env and fill in:  cp .env.template .env
#
# The Python CLI does not auto-load .env; pass it to uv:
#   uv run --env-file .env python -m tools.lingua author <target>
# (or export the variables in your shell instead).
#
# The web viewer is separate: Next.js only reads env files under web/, so
# put ANTHROPIC_API_KEY (and CHIRON_AGENT_MODEL) in web/.env.local too if
# you want the learning agent to use a key instead of your `claude` login.

# Required for the API-native authoring stage (tools.lingua author) — it
# calls the Claude API directly. Alternatively, `ant auth login` works
# without any key here.
ANTHROPIC_API_KEY=

# Authoring model + reasoning effort (defaults shown; leave empty to use
# them). Effort: low | medium | high | xhigh | max.
CHIRON_AUTHOR_MODEL=claude-sonnet-5
CHIRON_AUTHOR_EFFORT=medium

# Web viewer coach model override (read from web/.env.local, not this file;
# listed here so one template documents every knob).
CHIRON_AGENT_MODEL=
